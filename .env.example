# Copy to .env and set this value locally; never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Local Sentence Transformers model and persistent Chroma directory.
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
CYBER_ASSIST_CHROMA_PATH=backend/chroma_db

# Optional administrative key for the protected knowledge-base ingestion API.
KNOWLEDGE_BASE_ADMIN_KEY=
